# No backend is connected yet. The app runs entirely on local data
# (src/data/mockData.js + localStorage), so no env vars are required to run it.
#
# When a backend is chosen, add its vars here and re-enable the commented
# blocks in src/lib/supabase.js and src/services/*.
#
# Previous (Supabase) configuration, kept for reference:
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key
